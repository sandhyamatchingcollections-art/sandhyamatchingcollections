# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # 'Publishable key' (sb_publishable_...)

# ---- SERVER-ONLY SECRETS (Phase 6). Never share these in chat, email or screenshots,
# ---- and never add NEXT_PUBLIC_ to them. On Vercel, add them under Settings → Environment Variables.
# Supabase secret key (sb_secret_...): lets the server record payments it has verified.
SUPABASE_SECRET_KEY=
# Razorpay: Dashboard → Account & Settings → API Keys (use Test keys until launch)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay: Dashboard → Webhooks (after the site is live; localhost can't receive webhooks)
RAZORPAY_WEBHOOK_SECRET=
# Order emails (Phase 7, optional): resend.com → API Keys. EMAIL_FROM must use a domain you verified in Resend,
# e.g. "Sandhya Matching Collections <orders@yourdomain.com>". Without these, the store works and simply sends no emails.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: how long shared store data (menu, homepage, products) is kept before re-reading (seconds). Admin saves clear it at once. 0 = off.
# STORE_CACHE_SECONDS=60
